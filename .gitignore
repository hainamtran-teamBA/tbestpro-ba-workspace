# Đẩy toàn bộ workspace (kể cả Tài liệu gốc, PDF, Excel, ảnh) để chuyển máy.
# Chỉ giữ lại: bí mật, phiên đăng nhập, bộ nhớ đệm, rác của máy.

# Bí mật: không bao giờ đẩy lên
.env
.env.*
*.pem
*.key
tools/van-phong/.token

# Phiên đăng nhập trình duyệt, Cloudflare (có thông tin tài khoản)
.playwright-cli/
.playwright/
.wrangler/
**/.wrangler/

# Cơ sở dữ liệu cục bộ
*.db
*.db-shm
*.db-wal

# Rác của máy, bộ nhớ đệm
.DS_Store
node_modules/
__pycache__/
*.pyc
.claude/settings.local.json
tools/van-phong/node_modules/
tools/van-phong/.npm-cache/
Việc/.phien-chinh
Việc/.phien-trang.json

# Bản đồ Graphify: mỗi máy tự chạy /graphify
graphify-out/
**/graphify-out/
