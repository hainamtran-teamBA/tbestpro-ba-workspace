      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 200]
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v21.0/{{ $('Config').first().json.ad_account_id }}/ads",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "name,creative{body,title,video_id,thumbnail_url,effective_object_story_id}"
            },
            {
              "name": "limit",
              "value": "5"
            },
            {
              "name": "access_token",
              "value": "={{ $('Config').first().json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Duong 1 - Lay danh sach QC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 100],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst ads = first.data || [];\nconst out = ads\n  .filter(a => a.creative && a.creative.video_id)\n  .map(a => ({ json: { ad_name: a.name, video_id: a.creative.video_id } }));\nif (out.length === 0) {\n  return [{ json: { ghi_chu: 'Khong co quang cao nao co video_id (hoac API tra loi). Xem node truoc.', phan_hoi: first } }];\n}\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Loc ra video_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 100]
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v21.0/{{ $json.video_id }}",
